# Copy this file to .env and fill in your own values. Never commit .env itself.
# This file only contains fake placeholders, so it is safe to commit.
# Variables with the SHOP_ prefix are read by src/shoppilot/core/config.py.

SHOP_ENV=dev
SHOP_LOG_LEVEL=INFO
SHOP_LOG_DIR=logs
SHOP_LOG_TO_CONSOLE=true

# ---- Database (docker compose up -d db) ----
POSTGRES_PASSWORD=shop
SHOP_DATABASE_URL=postgresql+psycopg://shop:shop@localhost:5432/shoppilot

# ---- LLM (google | groq | ollama | anthropic) ----
SHOP_LLM_PROVIDER=google
SHOP_LLM_MODEL=your-model-name
SHOP_LLM_API_KEY=your-llm-api-key-here

# ---- Auth ----
SHOP_JWT_SECRET=dev-only-change-me

# ---- Limits (can also be changed in configs/settings.dev.yaml) ----
SHOP_AUTO_REFUND_LIMIT_PKR=3000
SHOP_MANAGER_LIMIT_PKR=15000
SHOP_REFUND_WINDOW_DAYS=14
SHOP_LATE_THRESHOLD_DAYS=5
SHOP_MAX_TOOL_CALLS=6
SHOP_MAX_RETRIES=2
SHOP_RUN_TIMEOUT_S=45
SHOP_APPROVAL_TTL_HOURS=48
SHOP_KB_MIN_SCORE=0.35

# ---- AWS (production only; on EC2 the secrets come from SSM) ----
SHOP_S3_BUCKET=

# ---- LangSmith ----
# The LangSmith SDK reads the unprefixed names below.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=shoppilot-dev
SHOP_LANGSMITH_TRACING=true
SHOP_LANGSMITH_PROJECT=shoppilot-dev

# ---- Shopify development store (Step E, optional) ----
# SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
# SHOPIFY_TOKEN=your-admin-api-token-here
