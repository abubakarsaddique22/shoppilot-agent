# SITE_ADDRESS comes from docker-compose.prod.yml: the DOMAIN setting (for example 13-233-1-2.sslip.io) gives automatic HTTPS,
# no DOMAIN means plain HTTP on port 80.
{$SITE_ADDRESS} {
    encode gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'"
    }
    handle_path /api/* {
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }
    handle {
        root * /srv/ui
        file_server
    }
}
